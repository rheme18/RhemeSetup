{
  "name": "rhemesetup",
  "version": "2.1.0",
  "description": "Bilingual Windows setup and system optimization toolkit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "Emir Aras Koç",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rheme.setup",
    "productName": "RhemeSetup",
    "win": {
      "target": "dir",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "RhemeSetup-v${version}-Portable.exe",
      "requestExecutionLevel": "admin"
    }
  }
}
